// webhook
{
  "name": "Telegram Bot",
  "config": {
    "type": "webhook",
    "default_funnel_id": "uuid",
    "default_stage_id": "uuid",
    "assignment_strategy": "round_robin",
    "assignment_pool": ["uuid1", "uuid2"],
    "field_mapping": {"phone": "lead.contact.phone"}
  }
}

